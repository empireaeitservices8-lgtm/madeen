# Point to your backend's WebSocket endpoint.
# Use your laptop's LAN IP (not localhost) if you want to open this on your phone too,
# since your phone can't reach your laptop's "localhost".
# Find your LAN IP with `ipconfig` (Windows) or `ifconfig`/`ip addr` (Mac/Linux) - e.g. 192.168.1.5
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/scan
