# Copy to backend/.env and adjust. Every setting is optional.

# First admin account (only used when the database has no users yet).
# If ADMIN_PASSWORD is empty, a random password is generated and printed once in the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Allowed frontend origins, comma-separated. "*" is fine on a private network.
CORS_ORIGINS=*

# Timezone for date filters and daily report buckets (default: this machine's local time)
# APP_TIMEZONE=Asia/Kolkata

# Login session length
JWT_EXPIRE_HOURS=12

# Where the SQLite database and snapshots are stored
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/ppe.db

# Models: swap PPE_MODEL_PATH for your own trained weights (see training/README.md)
# PPE_MODEL_PATH=./weights/ppe_yolov8n.pt
# POSE_MODEL_PATH=./weights/yolov8n-pose.pt
# DEVICE=          # empty = GPU if available, or "cpu"

# Detection tuning
PPE_CONFIDENCE=0.35
PERSON_CONFIDENCE=0.5
KEYPOINT_CONFIDENCE=0.5
SMOOTHING_FRAMES=8
